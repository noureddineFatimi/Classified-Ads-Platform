<!DOCTYPE html>
<html>
  <head>
    <title>Avito</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body>
  <header class="border-bottom py-2 shadow-sm position-sticky top-0 " style=" z-index: 9999; --bs-bg-opacity: 1;
    background-color: white; 
    display: flex;">
    <div class="container justify-content-between align-items-center" style="    width: auto;
    padding: 0.5rem;">
      <p style="    font-size: 18px;
    font-weight: bold;
    color: #2e6bff;"> Entrer les Informations du l'annonce</p>
      </div>
    </div>
  </header>

  <%= yield %>
</body>

</html>
