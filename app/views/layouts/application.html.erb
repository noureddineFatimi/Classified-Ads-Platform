<!DOCTYPE html>
<html>
  <head>
    <title>Avito</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body>
  <header class="bg-light border-bottom py-2 shadow-sm position-sticky top-0 " style = "z-index: 9999;" >
    <div class="container d-flex justify-content-between align-items-center" style = "    padding-top: 0.3rem;
    padding-bottom: 0.5rem;">
      <a href="<%= root_path %>" class="text-decoration-none">
        <img src="<%= asset_path('logo2.png') %>" alt="Logo Avito" height="30">
      </a>

      <div class="d-flex align-items-center " style = "gap : 1rem;">
        <% if session[:id_user] %>
          <% user = UserApp.find_by(id: session[:id_user]) %>
          <% if user %>
            <span class="me-3" style = "color: green;">Connecté en tant que <strong><%= user.username %></strong></span>
          <% end %>
          <%= link_to "Mes annonces", myAnnouncements_path, class: "btn btn-secondary" ,  style: "border-radius: 8px;"%>
          <%= button_to "Déconnexion", logout_path, method: :delete, class: "btn btn-danger" , style: "border-radius: 8px; padding: 0.5rem"%>
          <%= link_to "Publier une annonce", form1_path, class: "btn btn-primary" , style: "background-color: rgb(255, 76, 89);border-color: rgb(255, 76, 89); padding: 8px 24px; border-radius: 8px;"%>
        <% else %>
          <%= link_to "Se connecter", login_path, class: "btn btn-outline-success me-2" , style: "border-radius: 8px;"%>
          <%= link_to "Publier une annonce", form1_path, class: "btn btn-primary" ,style: "border-radius: 8px;" %>
        <% end %>
      </div>
    </div>
  </header>

  <%= yield %>
</body>

</html>
