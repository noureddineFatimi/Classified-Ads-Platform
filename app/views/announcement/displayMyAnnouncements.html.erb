<div style = "margin-bottom: 1rem;padding: 1.5rem;box-shadow: rgba(0, 0, 0, 0.07) 0px 2px 18px 0px;" class = "container mt-5">
<h3 class="mb-4">Mes Annonces</h3>

<% if flash[:success] %>
        <div class="alert alert-success text-center fw-bold">
          <%= flash[:success] %>
        </div>
      <% end %>

  <% if flash[:notice] %>
        <div class="alert alert-success text-center fw-bold">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:error] %>
        <div class="alert alert-danger text-center fw-bold">
          <%= flash[:error] %>
        </div>
      <% end %>

<%if @mesAnnonces.any?%>
<% @mesAnnonces.each do |annonce| %>
  <div class="card mb-3">
    <div class="card-body">
      <h5 class="card-title"><%= annonce.title %></h5>
      <p class="card-text"><%= annonce.description.truncate(100) %></p>
      <p class="card-text"><small class="text-muted"><%= annonce.city.name %> — <%= annonce.category_app.name %></small></p>
    <div class="d-flex justify-content-end gap-2 mt-3">
  <%= button_to "Supprimer", delete_announcement_path(annonce.id), method: :delete, data: { confirm: "Êtes-vous sûr de vouloir supprimer cette annonce ?" }, class: "btn btn-sm btn-danger" %>

  <%= link_to "Modifier", "edit/#{annonce.id}", class: "btn btn-sm btn-warning" %>

  <%= link_to "Voir", announcement_path(annonce.id), class: "btn btn-sm btn-primary" %>
</div>

    </div>
  </div>
<% end %>
<%else%>
<p class="text-muted">Vous n'avez pas d'annonces</p>
<%end%>
</div>